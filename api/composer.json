{
  "name": "fc-manager/online-api",
  "type": "project",
  "description": "FC Manager Online API built with Laravel.",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/sanctum": "^4.0"},
  "require-dev": {"fakerphp/faker": "^1.23", "laravel/pint": "^1.24", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.6", "phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "php artisan test",
    "lint": "vendor/bin/pint --test",
    "sync": "php artisan game:sync-data",
    "vercel": "@php artisan package:discover --ansi"
  },
  "extra": {"laravel": {"dont-discover": []}},
  "config": {"optimize-autoloader": true, "sort-packages": true}
}
