# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/vendor
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
api/bootstrap/cache/*.php
api/storage/*
!api/storage/framework/
!api/storage/framework/cache/
!api/storage/framework/cache/data/
!api/storage/framework/sessions/
!api/storage/framework/views/
!api/storage/logs/
api/storage/logs/*
!api/storage/logs/.gitkeep
!api/storage/**/.gitkeep
/.wrangler/
/outputs/
/work/
